{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PatchSorter: API Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "patchsorter.api.v1.main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "PatchSorter: Entry Point (server)",
      "type": "debugpy",
      "request": "launch",
      "module": "patchsorter",
      "args": ["server"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "PatchSorter: Entry Point (ui)",
      "type": "debugpy",
      "request": "launch",
      "module": "patchsorter",
      "args": ["ui"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}