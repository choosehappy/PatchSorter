COMPOSE_PROJECT_NAME=ps_services

# Host ports
CITUS_PORT=5438
SERVER_PORT=5008
UI_PORT=5178
RAY_DASHBOARD_PORT=8268

# Citus configuration
CITUS_HEAD_HOST=170.140.138.88   # This should be the hostname or IP address of the citus head node, accessible from the local network
CITUS_HEAD_PORT=5438
CITUS_HEAD_DB=postgres
CITUS_HEAD_USER=postgres
CITUS_HEAD_PASSWORD=password

CITUS_LOCAL_HOST=citus  # This should be localhost, since the local Citus instance is running on the same machine as the services
CITUS_LOCAL_PORT=5432
CITUS_LOCAL_DB=postgres
CITUS_LOCAL_USER=postgres
CITUS_LOCAL_PASSWORD=password